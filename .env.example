# Inbound webhooks (Developer resources > Other > Inbound webhook) with crm, user scopes.
SOURCE_WEBHOOK_URL=https://source.example.com/rest/1/xxxxxxxx/
DEST_WEBHOOK_URL=https://destination.example.com/rest/1/xxxxxxxx/
# Destination user that receives records whose original owner wasn't invited yet.
FALLBACK_USER_ID=1
